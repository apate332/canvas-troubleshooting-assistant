{
    "manifest_version": 3,
    "name": "Canvas Troubleshooting Assistant",
    "version": "0.1.0",
    "description": "Helps instructors and course designers troubleshoot Canvas activities.",

    "permissions": [
        "activeTab",
        "scripting"
    ],

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "action": {
        "default_popup": "popup.html",
        "default_title": "Canvas Troubleshooting Assistant",

        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    }
}